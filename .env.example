# Local app. Run npm run dev; no cloud credential is needed.
LAB_ENVIRONMENT=local
PORT=3000
# Hosted app: set LAB_ENVIRONMENT=staging or live in Railway.
# Railway supplies RAILWAY_DEPLOYMENT_ID. Build metadata is baked into the image.
# Operator ONLY: supply RAILWAY_PROJECT_TOKEN through a secret store.
# Optional operator LAB_CONFIG_JSON replaces config/lab.json; --config takes precedence.
# SOURCE_SHA and BUILD_RUN_ID are build inputs, not runtime identity overrides.
